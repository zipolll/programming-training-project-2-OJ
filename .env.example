OJ_APP_NAME=Programming Training OJ
OJ_ENVIRONMENT=development
OJ_DEBUG=false
OJ_API_PREFIX=/api
OJ_CORS_ORIGINS=["http://localhost:8501"]
OJ_FRONTEND_API_BASE_URL=http://localhost:8000/api
OJ_DATABASE_PATH=data/runtime/oj.sqlite3
OJ_PROBLEMS_PATH=data/problems
OJ_JUDGE_COMPILE_TIMEOUT_SECONDS=10
OJ_JUDGE_COMPILE_MEMORY_LIMIT_MB=512
OJ_JUDGE_OUTPUT_LIMIT_BYTES=65536
OJ_SESSION_COOKIE_NAME=session_id
OJ_SESSION_MAX_AGE_SECONDS=604800
OJ_SESSION_COOKIE_SECURE=false
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OJ_CREDENTIAL_ENCRYPTION_KEY=
OJ_AGENT_ALLOW_LOCAL_HTTP=true
OJ_AGENT_SHUTDOWN_TIMEOUT_SECONDS=3
